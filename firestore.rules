rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profile documents - User can read and edit only their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Emergency alerts - Created by owner, read by assigned emergency contacts or admin
    match /emergencyEvents/{eventId} {
      allow create, read, update: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Community posts - Authenticated users can read all posts, edit/delete their own
    match /communityPosts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.authorId == request.auth.uid;
      
      // Comments sub-collection
      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
        allow delete: if request.auth != null && resource.data.authorId == request.auth.uid;
      }
    }

    // Private Health Data (Period, Mood, Medication, Appointments) - Strictly private
    match /healthData/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
