# ============================================================
# SecureHer — Backend Environment Variables Template
# ============================================================
# On Vercel: paste these values into the Vercel Dashboard →
#   Project Settings → Environment Variables
# On local dev: copy this file to backend/.env and fill values.
# NEVER commit backend/.env to git.
# ============================================================

# --- Brevo Email API (for SOS alert dispatch) ---
# Get from: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your_brevo_api_key_here

# --- Brevo Sender Configuration ---
# Must be a verified sender in your Brevo account
BREVO_SENDER_EMAIL=alerts@secureher.app
BREVO_SENDER_NAME=SecureHer Emergency Dispatch

# --- Firebase Web API Key (for Firebase ID token verification) ---
# Get from: Firebase Console → Project Settings → General → Web API Key
# This is the same as VITE_FIREBASE_API_KEY on the frontend.
# It is NOT a service account key. Safe to store as a Vercel env var.
FIREBASE_API_KEY=your_firebase_web_api_key_here

# --- Google Gemini API Key (for SecureHer AI assistant) ---
# Get from: https://aistudio.google.com/app/apikey
# MUST remain server-side. NEVER put this in VITE_ variables.
GEMINI_API_KEY=your_gemini_api_key_here
