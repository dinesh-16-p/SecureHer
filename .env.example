# ============================================================
# SecureHer — Environment Variables Template
# ============================================================
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to git — it is excluded via .gitignore
# ============================================================

# --- Firebase Configuration ---
# Get these from: Firebase Console → Project Settings → Your Apps → Web App
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# --- MapTiler API (for Live Location Map) ---
# Get your key from: https://cloud.maptiler.com/account/keys
VITE_MAPTILER_API_KEY=your_maptiler_api_key_here

# --- FastAPI Backend URL ---
VITE_API_BASE_URL=http://localhost:8000
